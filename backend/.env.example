# --- Required for real guidance: one free key, no credit card ----------------
# Leave both empty to run in offline demo mode. With both, Gemini wins unless LLM_PROVIDER=groq.
# (A key in the repo-root .env works too.)
#
# Groq, the fastest: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_CHAT_MODEL=openai/gpt-oss-120b
#
# Gemini, the most precise pointing: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Comma-separated; the first model your key can reach is used.
GEMINI_MODEL=gemini-3.5-flash,gemini-2.5-flash
# gemini | groq | mock (default: whichever key is set)
LLM_PROVIDER=

# --- Server --------------------------------------------------------------------
PORT=8000
# Leave empty and a random key is generated once and kept in backend/.secret_key.
SECRET_KEY=
ACCESS_TOKEN_MINUTES=10080
CACHE_TTL_SECONDS=86400

# --- Background jobs ----------------------------------------------------------
SCHEDULER_ENABLED=true
WEEKLY_REPORT_DAY=mon
WEEKLY_REPORT_HOUR=8
STALE_SESSION_MINUTES=120
# Reminders the desktop app missed (it was closed) are emailed after this many minutes
REMINDER_EMAIL_GRACE_MINUTES=10
ADMIN_EMAILS=

# --- Email (optional). Gmail: enable 2FA, create an App Password ------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

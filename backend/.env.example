# --- Required for real guidance ---------------------------------------------
# Free key, no credit card: https://aistudio.google.com/apikey
# Leave empty to run in offline demo mode (LLM_PROVIDER=mock).
GEMINI_API_KEY=
# Comma-separated; the first model your key can reach is used.
GEMINI_MODEL=gemini-3.5-flash,gemini-2.5-flash

# --- Server --------------------------------------------------------------------
PORT=8000
# Use a long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_MINUTES=10080
CACHE_TTL_SECONDS=86400

# --- Background jobs ----------------------------------------------------------
SCHEDULER_ENABLED=true
WEEKLY_REPORT_DAY=mon
WEEKLY_REPORT_HOUR=8
STALE_SESSION_MINUTES=120
# Reminders the desktop app missed (it was closed) are emailed after this many minutes
REMINDER_EMAIL_GRACE_MINUTES=10
ADMIN_EMAILS=

# --- Email (optional). Gmail: enable 2FA, create an App Password ------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

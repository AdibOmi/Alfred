{
  "name": "alfred",
  "productName": "Alfred",
  "version": "0.1.0",
  "description": "A floating on-screen assistant: screenshot what you're looking at, ask a question, get step-by-step help.",
  "author": "AdibOmi",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "main": "dist/electron/main.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "start": "concurrently -k -s first \"npm:dev:react\" \"npm:dev:electron\"",
    "dev:react": "vite",
    "dev:electron": "wait-on tcp:5173 && electron -r tsx/cjs src/electron/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && vite build && electron-builder",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write ."
  },
  "build": {
    "appId": "dev.alfred.assistant",
    "productName": "Alfred",
    "files": ["dist/**/*"],
    "directories": {
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      }
    ],
    "win": {
      "icon": "build/icon.png"
    },
    "mac": {
      "icon": "build/icon.png"
    },
    "linux": {
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "electron-is-dev": "^2.0.0",
    "electron-store": "^8.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "concurrently": "^8.2.2",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.9",
    "wait-on": "^7.2.0"
  }
}

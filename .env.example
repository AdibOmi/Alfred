# Copy this file to .env (project root, for `npm run dev`) and fill in what you have.
# Alfred degrades gracefully — every integration below is optional; panels that
# aren't configured just show a "not configured" hint instead of failing.

# Powers the Chat panel and natural-language reminder parsing.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# GitHub activity panel. Username is enough for basic public activity via the
# REST events API. Add a token (no special scopes needed, just a classic or
# fine-grained PAT with public repo read access) to get the richer 30-day
# contribution calendar via GraphQL instead.
GITHUB_USERNAME=
GITHUB_TOKEN=

# LeetCode activity panel. Just your public username — no auth needed.
LEETCODE_USERNAME=
